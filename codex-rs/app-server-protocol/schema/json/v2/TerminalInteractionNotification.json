{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "TerminalWait": {
      "description": "Start or completion metadata for one `write_stdin` wait.",
      "oneOf": [
        {
          "description": "A wait has started for the identified invocation.",
          "properties": {
            "interactionId": {
              "description": "The `write_stdin` function-call ID, distinct from the command item ID.",
              "type": "string"
            },
            "mode": {
              "allOf": [
                {
                  "$ref": "#/definitions/TerminalWaitMode"
                }
              ],
              "description": "Whether this wait has a deadline or continues until process exit."
            },
            "phase": {
              "enum": [
                "started"
              ],
              "type": "string"
            },
            "startedAtMs": {
              "description": "Unix timestamp in milliseconds when the wait began.",
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "interactionId",
            "mode",
            "phase",
            "startedAtMs"
          ],
          "type": "object"
        },
        {
          "description": "A wait has ended; the process may still be running for non-exit reasons.",
          "properties": {
            "elapsedMs": {
              "description": "Actual elapsed wait time in milliseconds.",
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            "interactionId": {
              "description": "The `write_stdin` function-call ID matching the start event.",
              "type": "string"
            },
            "phase": {
              "enum": [
                "finished"
              ],
              "type": "string"
            },
            "reason": {
              "allOf": [
                {
                  "$ref": "#/definitions/TerminalWaitCompletionReason"
                }
              ],
              "description": "Why the wait finished."
            }
          },
          "required": [
            "elapsedMs",
            "interactionId",
            "phase",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "TerminalWaitCompletionReason": {
      "description": "Reason a `write_stdin` wait stopped waiting.",
      "oneOf": [
        {
          "description": "The associated process exited.",
          "enum": [
            "exited"
          ],
          "type": "string"
        },
        {
          "description": "The bounded poll deadline elapsed while the process remained live.",
          "enum": [
            "timeout"
          ],
          "type": "string"
        },
        {
          "description": "New turn input released an until-exit wait.",
          "enum": [
            "input"
          ],
          "type": "string"
        },
        {
          "description": "The tool invocation was cancelled.",
          "enum": [
            "cancelled"
          ],
          "type": "string"
        },
        {
          "description": "The wait ended because process or approval handling failed.",
          "enum": [
            "failed"
          ],
          "type": "string"
        }
      ]
    },
    "TerminalWaitMode": {
      "description": "Duration policy for a `write_stdin` wait.",
      "oneOf": [
        {
          "description": "Wait for the requested or resolved `yield_time_ms` deadline.",
          "enum": [
            "timed"
          ],
          "type": "string"
        },
        {
          "description": "Wait until the associated process exits or the waiter is released.",
          "enum": [
            "untilExit"
          ],
          "type": "string"
        }
      ]
    }
  },
  "properties": {
    "deadlineAtMs": {
      "default": null,
      "description": "Unix timestamp (in milliseconds) when a bounded wait should report back. Until-exit waits and completed waits have no deadline.",
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "itemId": {
      "type": "string"
    },
    "processId": {
      "type": "string"
    },
    "stdin": {
      "type": "string"
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    },
    "wait": {
      "anyOf": [
        {
          "$ref": "#/definitions/TerminalWait"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Lifecycle metadata for a `write_stdin` wait. Null for legacy events."
    }
  },
  "required": [
    "itemId",
    "processId",
    "stdin",
    "threadId",
    "turnId"
  ],
  "title": "TerminalInteractionNotification",
  "type": "object"
}